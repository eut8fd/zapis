# Репозиторий публичный. Всё, что ниже, не должно попасть в него никогда:
# это либо ключи, либо данные живых людей, либо мусор сборки.

# --- секреты -----------------------------------------------------------
# .env хранит токен бота и секретный код панели. .env.example — шаблон
# с пустыми значениями, он нужен в репозитории.
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx

# --- данные людей ------------------------------------------------------
# users.json — telegram-id всех, кто писал боту; bookings.json — их записи;
# shared.json в .run — общий склад бота и Mini App. Это база клиентов.
bot/users.json
bot/bookings.json
bot/*.local.json
.run/
*.db
*.sqlite
*.sqlite3
backend/*.db

# --- сборка и мусор ----------------------------------------------------
# сюда скачивается cloudflared, 54 МБ — комментарий отдельной строкой:
# в .gitignore текст после образца не комментарий, а часть самого образца,
# и «tools/ # …» перестаёт что-либо игнорировать
tools/
*.log
__pycache__/
*.egg-info/
.pytest_cache/
backend/.venv/
.venv/
node_modules/
.DS_Store
Thumbs.db
