# Скопируйте в .env и заполните. Сам .env в репозиторий не попадает.
# Файл читается и демо-частью, и backend. Без BOM: BOM ломает docker compose
# env_file и json.load.

# --- обязательное ---
BOT_TOKEN=                       # токен от @BotFather
WEBAPP_URL=                      # https-адрес приложения (GitHub Pages или ваш домен)

# --- локальный запуск демо ---
PORT=8080

# --- как бот выглядит для пользователей ---
BRAND_NAME=Zapis
BOT_NAME=Zapis — онлайн-запись   # имя бота в профиле; пусто = не менять
BOT_USERNAME=                    # username бота без @, нужен для ссылок-приглашений
SUPPORT_USERNAME=                # username поддержки без @; пусто = кнопка скрыта

# --- панель Super Admin (демо) ---
# В демо панель открыта свободно (webapp/js/config.js -> DEMO_OPEN_ADMIN).
# В production backend платформенная роль хранится в БД (users.platform_role),
# а эти поля используются только для первичной выдачи прав.
ADMIN_TG_IDS=                    # Telegram ID через запятую
ADMIN_CODE=                      # секретный код (его SHA-256 лежит в config.js)


# ===================== production backend =====================
# Всё ниже читает backend/app/config.py. Неверная конфигурация валит
# запуск сразу, а не всплывает в рантайме.

APP_ENV=local                    # local | test | staging | production
RELEASE=dev                      # тег релиза, попадает в логи и error tracker
DEBUG=                           # пусто = по окружению

# Источник истины. В staging/production обязан быть PostgreSQL.
# Локально можно оставить пустым — тогда возьмётся SQLite в .run/zapis.db
DATABASE_URL=                    # postgresql+asyncpg://user:pass@host:5432/zapis
DATABASE_POOL_SIZE=10
DATABASE_ECHO=false

# Redis: rate limit и координация worker. Обязателен вне локальной разработки.
REDIS_URL=                       # redis://redis:6379/0

# Секрет подписи сессий. От 32 символов, свой на каждое окружение.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
TELEGRAM_AUTH_MAX_AGE_SECONDS=300   # срок жизни initData, максимум 900

# Webhook Telegram. Секрет попадает и в путь, и в заголовок.
TELEGRAM_WEBHOOK_SECRET=

PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=                    # через запятую; пусто = CORS выключен
EXPOSE_API_DOCS=                 # в production всегда false

# Лимиты запросов в минуту
RATE_LIMIT_ANON_PER_MIN=60
RATE_LIMIT_USER_PER_MIN=240
RATE_LIMIT_AUTH_PER_MIN=20

# Правила записи по умолчанию; компания может переопределить в настройках
BOOKING_HORIZON_DAYS=90
BOOKING_LEAD_TIME_MINUTES=60
SLOT_STEP_MINUTES=30

# AI работает только через серверный proxy: ключ на фронт не попадает
AI_PROVIDER_URL=
AI_PROVIDER_KEY=
AI_MODEL=claude-sonnet-5

MEDIA_ROOT=
MEDIA_MAX_BYTES=8388608

# Платёжный провайдер выбирается на Этапе 0 ТЗ
PAYMENT_PROVIDER=none
PAYMENT_WEBHOOK_SECRET=

# --- локальная песочница ---
# Задаются скриптом scripts\sandbox.ps1; руками сюда писать не нужно.
# Вход без Telegram и доставка уведомлений в файл вместо Bot API.
# Конфигурация не даёт запустить с ними staging или production.
DEV_AUTH_ENABLED=false
NOTIFY_TRANSPORT=telegram        # telegram | local
SANDBOX_INBOX_PATH=

# --- только для docker compose ---
DOMAIN=                          # ваш домен, например zapis.example.com
DATA_DIR=/data                   # где демо-бот хранит users.json и bookings.json
POSTGRES_DB=zapis
POSTGRES_USER=zapis
POSTGRES_PASSWORD=
