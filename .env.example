# Скопируйте в .env и заполните. Сам .env в репозиторий не попадает.

# --- обязательное ---
BOT_TOKEN=                       # токен от @BotFather
WEBAPP_URL=                      # https-адрес приложения (GitHub Pages или ваш домен)

# --- локальный запуск ---
PORT=8080

# --- как бот выглядит для пользователей ---
BRAND_NAME=Zapis
BOT_NAME=Zapis — онлайн-запись   # имя бота в профиле; пусто = не менять
SUPPORT_USERNAME=                # username поддержки без @; пусто = кнопка скрыта

# --- панель Super Admin ---
# В демо панель открыта свободно (webapp/js/config.js -> DEMO_OPEN_ADMIN).
# Для продакшена поставьте там false и заполните эти поля:
ADMIN_TG_IDS=                    # Telegram ID через запятую
ADMIN_CODE=                      # секретный код (его SHA-256 лежит в config.js)

# --- только для docker compose ---
DOMAIN=                          # ваш домен, например zapis.example.com
DATA_DIR=/data                   # где бот хранит users.json и bookings.json
