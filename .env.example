# Скопируйте в .env и заполните. Сам .env в репозиторий не попадает.
# Файл читают сервер, бот и production-backend. Без BOM: BOM ломает
# docker compose env_file и json.load.

# --- обязательное ---
BOT_TOKEN=                       # токен от @BotFather
WEBAPP_URL=                      # https-адрес приложения (GitHub Pages или ваш домен)

# --- сервер (server/serve.py): API, Mini App, уведомления ---
PORT=8080
ADMIN_TG_IDS=                    # Telegram ID администраторов платформы через запятую
INTERNAL_TOKEN=                  # токен для бота; пусто = сервер создаст .run/internal.token
                                 # (в docker compose бот в другом контейнере — задайте явно)
DATA_DIR=                        # где лежит база zapis.db; пусто = .run рядом с проектом
TZ_DEFAULT=Asia/Almaty           # зона по умолчанию для компаний без своей
PAYMENT_NOTE=                    # как платить за подписку: реквизиты, Kaspi — владелец видит это в «Подписке»
GRACE_DAYS=3                     # сколько дней после окончания подписки ещё принимать записи
TRIAL_DAYS=14                    # пробный период новой компании
DEV_AUTH=false                   # true только для разработки: вход без Telegram через ?dev=1:Имя

# --- бот (bot/bot.py) ---
SERVER_URL=                      # адрес сервера для бота; пусто = http://127.0.0.1:PORT
BRAND_NAME=Zapis
BOT_NAME=Zapis — онлайн-запись   # имя бота в профиле; пусто = не менять
SUPPORT_USERNAME=                # username поддержки без @; пусто = кнопка скрыта
ADMIN_CODE=                      # секретный код панели в демо-режиме (его SHA-256 лежит в config.js)

# --- AI через сервер (ключ не попадает в браузер) ---
AI_PROVIDER_KEY=                 # ключ Claude API; пусто = AI в демо-режиме
AI_MODEL=claude-opus-5-5
AI_PROVIDER_URL=https://api.anthropic.com/v1/messages

# --- только для docker compose ---
DOMAIN=                          # ваш домен, например zapis.example.com


# ===================== production backend (backend/) =====================
# Отдельный контур по TZ_PRODUCTION.md; к работе Mini App и бота выше
# не относится. Всё ниже читает backend/app/config.py.

APP_ENV=local                    # local | test | staging | production
RELEASE=dev
DEBUG=
DATABASE_URL=                    # postgresql+asyncpg://user:pass@host:5432/zapis
DATABASE_POOL_SIZE=10
DATABASE_ECHO=false
REDIS_URL=
SESSION_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
TELEGRAM_AUTH_MAX_AGE_SECONDS=300
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=
EXPOSE_API_DOCS=
RATE_LIMIT_ANON_PER_MIN=60
RATE_LIMIT_USER_PER_MIN=240
RATE_LIMIT_AUTH_PER_MIN=20
BOOKING_HORIZON_DAYS=90
BOOKING_LEAD_TIME_MINUTES=60
SLOT_STEP_MINUTES=30
MEDIA_ROOT=
MEDIA_MAX_BYTES=8388608
PAYMENT_PROVIDER=none
PAYMENT_WEBHOOK_SECRET=
DEV_AUTH_ENABLED=false
NOTIFY_TRANSPORT=telegram
SANDBOX_INBOX_PATH=
POSTGRES_DB=zapis
POSTGRES_USER=zapis
POSTGRES_PASSWORD=
